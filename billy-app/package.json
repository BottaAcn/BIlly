{
  "name": "billy-app",
  "version": "1.0.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cap-js/attachments": "^4.0.0",
    "@cap-js/hana": "^3",
    "@sap-ai-sdk/foundation-models": "^2.15.0",
    "@sap-ai-sdk/orchestration": "^2.15.0",
    "@sap/cds": "^10",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "server": {
      "body_parser": { "limit": "15mb" }
    },
    "requires": {
      "db": {
        "kind": "sqlite",
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "kind": "dummy"
      },
      "attachments": {
        "kind": "db",
        "scan": false,
        "[production]": { "kind": "db", "scan": false }
      },
      "malwareScanner": {
        "kind": "malwareScanner-mocked",
        "[production]": { "kind": "malwareScanner-mocked" }
      }
    }
  },
  "private": true
}
