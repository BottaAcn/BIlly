{
  "welcomeFile": "/index.html",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/rest/(.*)$",
      "target": "/rest/$1",
      "destination": "billy-srv-api",
      "csrfProtection": false
    },
    {
      "source": "^/mcp/(.*)$",
      "target": "/mcp/$1",
      "destination": "billy-srv-api",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "target": "/billyui$1",
      "service": "html5-apps-repo-rt"
    }
  ]
}
